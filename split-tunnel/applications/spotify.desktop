[Desktop Entry]
Type=Application
Name=Spotify
GenericName=Music Player
Comment=Spotify music streaming (outside Mullvad tunnel)
Icon=spotify-client
TryExec=/usr/bin/mullvad-exclude
Exec=/usr/bin/mullvad-exclude /usr/bin/spotify --uri=%u
Terminal=false
MimeType=x-scheme-handler/spotify;
Categories=Audio;Music;Player;AudioVideo;
StartupWMClass=spotify
